{
  "name": "damright",
  "private": true,
  "version": "0.1.0",
  "description": "High-performance offline-first Personal Digital Asset Manager (DAM) built with Tauri, Rust, and React",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm run build && npm test -- --run && npm run test:e2e && cd src-tauri && cargo check && cargo test",
    "tauri": "tauri",
    "server": "npm run build && cd src-tauri && cargo run --bin damright-server",
    "cli": "cd src-tauri && cargo run --bin damright-cli --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/react-window": "^1.8.8",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "react-window": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
